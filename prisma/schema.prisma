generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// PLATAFORMA (SaaS): condomínios clientes, planos e cobrança
// ------------------------------------------------------

enum StatusCondominio {
  TESTE // período de avaliação gratuito
  ATIVO // assinatura em dia
  INADIMPLENTE // fatura vencida, ainda dentro da carência
  SUSPENSO // bloqueado (teste expirado ou inadimplência além da carência)
  CANCELADO
}

enum TipoCondominio {
  COMERCIAL
  RESIDENCIAL
  MISTO
}

model Plano {
  id              String       @id @default(cuid())
  nome            String       @unique
  descricao       String       @default("")
  precoMensal     Decimal      @db.Decimal(10, 2)
  // null = ilimitado
  maxUsuarios     Int?
  maxMensagensMes Int?
  ativo           Boolean      @default(true)
  ordem           Int          @default(0)
  condominios     Condominio[]
}

model Condominio {
  id     String           @id @default(cuid())
  nome   String
  slug   String           @unique
  tipo   TipoCondominio   @default(COMERCIAL)
  cnpj   String?
  status StatusCondominio @default(TESTE)

  // Descrição do prédio usada pelo agente (estrutura, equipes, regras da casa)
  perfil          String @default("")
  fuso            String @default("America/Sao_Paulo")
  horaInicioDia   String @default("07:00")
  horaInicioNoite String @default("19:00")

  // WhatsApp Cloud API: número próprio do condomínio
  whatsappPhoneNumberId  String? @unique
  whatsappNumeroExibicao String?
  whatsappTokenCripto    String? // token criptografado; vazio = usa o token da plataforma

  // Contato e cobrança
  responsavelNome     String
  responsavelEmail    String
  responsavelTelefone String?
  cpfCnpjCobranca     String?
  planoId             String?
  plano               Plano?    @relation(fields: [planoId], references: [id])
  testeAte            DateTime?
  inadimplenteDesde   DateTime?
  asaasCustomerId     String?   @unique
  asaasSubscriptionId String?   @unique

  // Numeração sequencial de ocorrências por condomínio
  ultimoNumeroOcorrencia Int @default(0)

  criadoEm DateTime @default(now())

  usuarios    Usuario[]
  equipes     Equipe[]
  locais      Local[]
  rondas      Ronda[]
  ocorrencias Ocorrencia[]
  acessos     RegistroAcesso[]
  apoios      AtendimentoAcessibilidade[]
  passagens   PassagemTurno[]
  livros      LivroDiario[]
  faturas     Fatura[]
  usos        UsoMensal[]
  auditoria   EventoAuditoria[]

  @@index([status])
}

model Fatura {
  id             String     @id @default(cuid())
  condominioId   String
  condominio     Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  asaasPaymentId String     @unique
  valor          Decimal    @db.Decimal(10, 2)
  vencimento     DateTime   @db.Date
  status         String // status do Asaas (PENDING, RECEIVED, CONFIRMED, OVERDUE…)
  linkFatura     String?
  pagaEm         DateTime?
  atualizadaEm   DateTime   @updatedAt

  @@index([condominioId, vencimento])
}

// Consumo do agente por mês (limites do plano e custo)
model UsoMensal {
  condominioId  String
  condominio    Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  mes           String // AAAA-MM
  mensagens     Int        @default(0)
  tokensEntrada Int        @default(0)
  tokensSaida   Int        @default(0)
  tokensCache   Int        @default(0)

  @@id([condominioId, mes])
}

model AdminPlataforma {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}

model EventoAuditoria {
  id           String      @id @default(cuid())
  condominioId String?
  condominio   Condominio? @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  autor        String // nome de quem fez (usuário, admin da plataforma ou "sistema")
  acao         String
  detalhes     Json?
  criadoEm     DateTime    @default(now())

  @@index([condominioId, criadoEm])
}

// Eventos do Asaas já processados (o Asaas pode reenviar)
model AsaasEventoProcessado {
  id         String   @id
  recebidoEm DateTime @default(now())
}

// ------------------------------------------------------
// PESSOAS E ESCALAS
// ------------------------------------------------------

enum Papel {
  TI_ADMIN
  SINDICA
  ADMINISTRACAO
  FINANCEIRO
  SUPERVISOR
  ENCARREGADO
  PORTEIRO
  RECEPCIONISTA
}

enum Turno {
  DIA // 07h às 19h
  NOITE // 19h às 07h
}

model Usuario {
  id           String     @id @default(cuid())
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  nome         String
  login        String     @unique
  senhaHash    String
  papel        Papel
  // Número de WhatsApp no formato internacional, só dígitos (ex.: 5511999998888)
  telefone     String?
  ativo        Boolean    @default(true)
  equipeId     String?
  equipe       Equipe?    @relation(fields: [equipeId], references: [id])
  // Recepcionistas: horário de trabalho (HH:MM) e dia da folga (0 = domingo … 6 = sábado)
  horaInicio   String?
  horaFim      String?
  diaFolga     Int?
  criadoEm     DateTime   @default(now())

  rondas                Ronda[]
  ocorrencias           Ocorrencia[]                @relation("OcorrenciaRegistradaPor")
  ocorrenciasResolvidas Ocorrencia[]                @relation("OcorrenciaResolvidaPor")
  acessos               RegistroAcesso[]
  apoiosSolicitados     AtendimentoAcessibilidade[] @relation("ApoioSolicitadoPor")
  apoiosAtendidos       AtendimentoAcessibilidade[] @relation("ApoioAtendidoPor")
  passagens             PassagemTurno[]
  conversas             ConversaAgente[]

  @@unique([condominioId, telefone])
  @@index([condominioId])
}

// Equipes de portaria em escala 12x36: A/B no dia, C/D na noite.
model Equipe {
  id             String     @id @default(cuid())
  condominioId   String
  condominio     Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  nome           String
  turno          Turno
  // Uma data (AAAA-MM-DD) em que a equipe trabalhou. Em 12x36 ela trabalha em dias alternados a partir daí.
  dataReferencia DateTime   @db.Date
  membros        Usuario[]

  @@unique([condominioId, nome])
}

// ------------------------------------------------------
// ESPAÇOS DO PRÉDIO
// ------------------------------------------------------

enum TipoLocal {
  RECEPCAO
  ANDAR
  SUBSOLO
  PRACA_ALIMENTACAO
  LOJAS
  AREA_EXTERNA
  OUTRO
}

model Local {
  id                String     @id @default(cuid())
  condominioId      String
  condominio        Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  nome              String
  tipo              TipoLocal
  ordem             Int        @default(0)
  ativo             Boolean    @default(true)
  // Se o local entra no checklist de rondas e de quanto em quanto tempo (minutos). null = 1 vez por turno.
  exigeRonda        Boolean    @default(true)
  intervaloRondaMin Int?
  // Ex.: praça de alimentação fecha aos domingos -> [0]
  diasFechado       Int[]      @default([])

  rondas      Ronda[]
  ocorrencias Ocorrencia[]
  acessos     RegistroAcesso[]

  @@unique([condominioId, nome])
}

// ------------------------------------------------------
// OPERAÇÃO
// ------------------------------------------------------

enum Canal {
  WEB
  WHATSAPP
  SISTEMA
}

model Ronda {
  id           String       @id @default(cuid())
  condominioId String
  condominio   Condominio   @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  localId      String
  local        Local        @relation(fields: [localId], references: [id])
  porteiroId   String
  porteiro     Usuario      @relation(fields: [porteiroId], references: [id])
  realizadaEm  DateTime     @default(now())
  comAlteracao Boolean      @default(false)
  observacao   String?
  canal        Canal        @default(WEB)
  ocorrencias  Ocorrencia[]

  @@index([condominioId, realizadaEm])
}

enum CategoriaOcorrencia {
  SEGURANCA
  MANUTENCAO
  LIMPEZA
  ACESSO
  ACESSIBILIDADE
  CONVIVENCIA
  GARAGEM
  EMERGENCIA
  OUTRO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum Setor {
  ADMINISTRACAO
  FINANCEIRO
  SUPERVISOR
  SINDICA
  PORTARIA
  RECEPCAO
  TI
}

enum StatusOcorrencia {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
}

model Ocorrencia {
  id                String              @id @default(cuid())
  condominioId      String
  condominio        Condominio          @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  numero            Int // sequencial dentro do condomínio
  titulo            String
  descricao         String
  categoria         CategoriaOcorrencia
  prioridade        Prioridade          @default(MEDIA)
  setor             Setor
  status            StatusOcorrencia    @default(ABERTA)
  localId           String?
  local             Local?              @relation(fields: [localId], references: [id])
  sala              String?
  fotos             String[]            @default([])
  rondaId           String?
  ronda             Ronda?              @relation(fields: [rondaId], references: [id])
  registradoPorId   String
  registradoPor     Usuario             @relation("OcorrenciaRegistradaPor", fields: [registradoPorId], references: [id])
  canal             Canal               @default(WEB)
  criadaEm          DateTime            @default(now())
  atualizadaEm      DateTime            @updatedAt
  resolvidaEm       DateTime?
  resolvidaPorId    String?
  resolvidaPor      Usuario?            @relation("OcorrenciaResolvidaPor", fields: [resolvidaPorId], references: [id])
  resolucao         String?
  setorNotificadoEm DateTime?

  @@unique([condominioId, numero])
  @@index([condominioId, status, setor])
  @@index([condominioId, criadaEm])
}

enum TipoAcesso {
  VISITANTE
  PRESTADOR
  ENTREGA
  CANDIDATO
  OUTRO
}

// Registro operacional de quem entrou. O cadastro oficial da credencial continua no Invenzi;
// aqui guardamos o espelho para consulta rápida, passagem de turno e livro do dia.
model RegistroAcesso {
  id                String     @id @default(cuid())
  condominioId      String
  condominio        Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  nome              String
  // Guardamos só os 4 últimos dígitos do documento (LGPD). O documento completo fica no Invenzi.
  documentoFinal    String?
  tipo              TipoAcesso @default(VISITANTE)
  sala              String?
  empresa           String?
  localId           String?
  local             Local?     @relation(fields: [localId], references: [id])
  cadastradoInvenzi Boolean    @default(false)
  invenziId         String?
  entradaEm         DateTime   @default(now())
  saidaEm           DateTime?
  observacao        String?
  registradoPorId   String
  registradoPor     Usuario    @relation(fields: [registradoPorId], references: [id])
  canal             Canal      @default(WEB)

  @@index([condominioId, entradaEm])
}

enum TipoNecessidade {
  CADEIRANTE
  MOBILIDADE_REDUZIDA
  IDOSO
  DEFICIENCIA_VISUAL
  DEFICIENCIA_AUDITIVA
  GESTANTE
  OUTRO
}

enum StatusApoio {
  SOLICITADO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
}

model AtendimentoAcessibilidade {
  id              String          @id @default(cuid())
  condominioId    String
  condominio      Condominio      @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  pessoa          String
  necessidade     TipoNecessidade
  destino         String?
  observacao      String?
  status          StatusApoio     @default(SOLICITADO)
  solicitadoPorId String
  solicitadoPor   Usuario         @relation("ApoioSolicitadoPor", fields: [solicitadoPorId], references: [id])
  atendidoPorId   String?
  atendidoPor     Usuario?        @relation("ApoioAtendidoPor", fields: [atendidoPorId], references: [id])
  criadoEm        DateTime        @default(now())
  iniciadoEm      DateTime?
  concluidoEm     DateTime?

  @@index([condominioId, status])
}

model PassagemTurno {
  id           String     @id @default(cuid())
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  // Data do plantão (o turno da noite pertence à data em que começou, às 19h)
  data         DateTime   @db.Date
  turno        Turno
  resumo       String
  geradoEm     DateTime   @default(now())
  autorId      String?
  autor        Usuario?   @relation(fields: [autorId], references: [id])

  @@index([condominioId, data, turno])
}

// Livro de ocorrências digital do dia (substitui o livro escrito pelo encarregado).
model LivroDiario {
  id           String     @id @default(cuid())
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  data         DateTime   @db.Date
  conteudo     String
  geradoEm     DateTime   @default(now())
  conferidoPor String?
  conferidoEm  DateTime?

  @@unique([condominioId, data])
}

// ------------------------------------------------------
// AGENTE
// ------------------------------------------------------

model ConversaAgente {
  id           String           @id @default(cuid())
  usuarioId    String
  usuario      Usuario          @relation(fields: [usuarioId], references: [id])
  canal        Canal
  // Uma conversa por pessoa, canal e plantão: o histórico recomeça a cada turno.
  chavePlantao String
  criadaEm     DateTime         @default(now())
  mensagens    MensagemAgente[]

  @@unique([usuarioId, canal, chavePlantao])
}

model MensagemAgente {
  id         String         @id @default(cuid())
  conversaId String
  conversa   ConversaAgente @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  role       String // "user" | "assistant"
  // Conteúdo exatamente como enviado/recebido da API (blocos), para reenviar sem alterações.
  conteudo   Json
  criadaEm   DateTime       @default(now())

  @@index([conversaId, criadaEm])
}

// Mensagens do WhatsApp já processadas (a Meta pode reenviar o mesmo webhook).
model WhatsappMensagemProcessada {
  id         String   @id // wamid
  recebidaEm DateTime @default(now())
}

model TarefaAgendadaExecucao {
  chave       String   @id // ex.: "passagem:2026-10-12:DIA"
  executadaEm DateTime @default(now())
}
