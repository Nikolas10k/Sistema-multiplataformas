# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/condominio?schema=public"

# Segredo das sessões de login (gere com: openssl rand -hex 32)
SESSION_SECRET=""

# Claude (Anthropic)
ANTHROPIC_API_KEY=""
AGENTE_MODELO="claude-opus-5-5"
# low | medium | high
AGENTE_ESFORCO="medium"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v23.0"

# Tarefas automáticas (passagem de turno, livro do dia, alertas de ronda)
AGENDADOR_ATIVO="true"

# Pasta onde ficam as fotos recebidas
UPLOAD_DIR="./uploads"

# Usuário administrador criado pelo seed
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_SENHA=""

# Docker Compose
POSTGRES_USER="condominio"
POSTGRES_PASSWORD=""
POSTGRES_DB="condominio"
# Porta publicada no servidor (o portal.givanceresto.com.br já aponta para a 3001)
PORTA_APP="3001"
# Quantidade de andares criados pelo seed (ajuste depois em Cadastros)
SEED_ANDARES="20"
