# ---------------------------------------------------------------- Plataforma
NOME_PRODUTO="Givance Condomínio"
# Endereço público (usado nas instruções de webhook)
URL_PUBLICA="https://app.seudominio.com.br"
DIAS_TESTE="14"
# Dias de tolerância após uma fatura vencer antes de suspender o acesso
DIAS_CARENCIA="7"

# ---------------------------------------------------------------- Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/condominio?schema=public"

# ---------------------------------------------------------------- Segurança
# Segredo das sessões de login: openssl rand -hex 32
SESSION_SECRET=""
# Chave para criptografar os tokens de WhatsApp guardados no banco: openssl rand -hex 32
# (não troque depois de configurado, ou os tokens salvos ficam ilegíveis)
ENCRYPTION_KEY=""

# Administrador da plataforma criado pelo seed (área /plataforma)
PLATAFORMA_ADMIN_EMAIL=""
PLATAFORMA_ADMIN_SENHA=""

# ---------------------------------------------------------------- Claude (Anthropic)
ANTHROPIC_API_KEY=""
AGENTE_MODELO="claude-opus-5-5"
# low | medium | high
AGENTE_ESFORCO="medium"

# ---------------------------------------------------------------- WhatsApp Cloud API (app da plataforma na Meta)
# O webhook (/api/whatsapp) é único; cada condomínio conecta o próprio número em Configurações.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Token padrão, usado pelos números que não tiverem token próprio
WHATSAPP_TOKEN=""
WHATSAPP_GRAPH_VERSION="v23.0"

# ---------------------------------------------------------------- Cobrança (Asaas)
ASAAS_API_KEY=""
# sandbox | producao
ASAAS_AMBIENTE="sandbox"
# Token configurado no webhook do Asaas (enviado no header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------- Operação
# Tarefas automáticas (passagem de turno, livro do dia, alertas, cobrança). Deixe ativo em só UMA instância.
AGENDADOR_ATIVO="true"
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------- Docker Compose
POSTGRES_USER="condominio"
POSTGRES_PASSWORD=""
POSTGRES_DB="condominio"
PORTA_APP="3001"
